# ==============================================================================
# DripbyAI - Environment Variables
# ==============================================================================

# Required: Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: OpenRouter API for Educational / Live AI Analysis
# Obtain your key at: https://openrouter.ai/keys
# (Can also be configured on the go directly in the Admin Console at /admin)
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
